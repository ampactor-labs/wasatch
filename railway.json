{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --omit=dev --ignore-scripts"
  },
  "deploy": {
    "startCommand": "node conductor/src/server.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS"
  }
}
